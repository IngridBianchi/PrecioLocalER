# ============================================================
# PrecioLocal ER — variables de entorno
# Copiar a .env y completar con valores reales. NUNCA versionar .env
# ============================================================

# ---- Infraestructura local (docker compose) ----
# ⚠️ Sin defaults: el compose aborta si falta cualquiera de estas passwords.
# Generá valores reales, por ejemplo:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_USER=preciolocal
POSTGRES_PASSWORD=
POSTGRES_DB=preciolocal
POSTGRES_PORT=5432

# ---- Roles de servicio de Postgres (P0.1) ----
# El scraper, ml-dotnet y analytics-java NO conectan como POSTGRES_USER: ese rol es
# superusuario del contenedor, y un superusuario se saltea la RLS por más
# policies que haya (rolbypassrls). Conectando como superusuario, la
# separación por usuario y por rol de 007/011 era decorativa.
#
# Estos son los usuarios reales; los grupos NOLOGIN (`pl_scraper`, `pl_ml`) y
# sus GRANTs viven en la migración 011. Generá passwords distintas:
#   scripts/db-rotate-roles.sh db
# o a mano: python -c "import secrets; print(secrets.token_urlsafe(32))"
SCRAPER_DB_USER=preciolocal_scraper
SCRAPER_DB_PASSWORD=
ML_DB_USER=preciolocal_ml
ML_DB_PASSWORD=
ANALYTICS_DB_USER=preciolocal_analytics
ANALYTICS_DB_PASSWORD=

# 6379 y 6380: hay Redis nativos locales ocupándolos → compose usa 6381.
# El Redis del compose arranca con requirepass (REDIS_PASSWORD).
REDIS_PORT=6381
REDIS_PASSWORD=

MONGO_USER=preciolocal
MONGO_PASSWORD=
MONGO_DB=preciolocal
# 27017 está ocupado por un mongod nativo local → compose usa 27018.
MONGO_PORT=27018

# ---- Scraper (Fase 1) ----
APP_ENVIRONMENT=development
SCRAPER_PORT=8000
ML_DOTNET_PORT=8001
ANALYTICS_JAVA_PORT=8080
GATEWAY_PORT=4000
WEB_PORT=4200
# Token para POST /scrape/run/* (dejar vacío = 501 "no implementado")
ADMIN_TOKEN=
# Delay mínimo entre requests al sitio (respecto robots.txt, conservador)
# SCRAPER_MIN_REQUEST_INTERVAL=2.0
# Categorías de La Anónima (separadas por coma; slugs de sitemap-listados.xml)
# LA_ANONIMA_CATEGORIES=https://www.laanonima.com.ar/aceite/n3_604/,https://www.laanonima.com.ar/harina-de-trigo/n3_621/
# API key del BFF público de Coto (obligatoria: sin ella el scrape de Coto falla)
# COTO_DIGITAL_API_KEY=

# ---- API (Fase 1) ----
# Orígenes CORS permitidos, separados por coma
CORS_ORIGINS=http://localhost:4200
# Redis es OPCIONAL en Fase 1: vacío = /ready solo chequea la DB.
REDIS_URL=

# ---- Conexiones (local) ----
# Apunta al rol de servicio, no a POSTGRES_USER (mismo motivo que arriba).
DATABASE_URL=postgresql://preciolocal_scraper:<SCRAPER_DB_PASSWORD>@localhost:5432/preciolocal
# Redis del compose: la credencial va separada (REDIS_PASSWORD) y el scraper la
# inyecta en el storage URI de slowapi. Vacío = /ready solo chequea la DB.
# REDIS_URL=redis://localhost:6381
MONGO_URL=mongodb://preciolocal:<MONGO_PASSWORD>@localhost:27017/preciolocal?authSource=admin

# ---- Producción (filled en deploy; ver docs/deploy.md) ----
# Supabase / Postgres de producción
SUPABASE_URL=
SUPABASE_DB_URL=
SUPABASE_JWT_SECRET=
# Upstash Redis
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=
# MongoDB Atlas
MONGO_ATLAS_URL=
# Gateway
GATEWAY_INTERNAL_TOKEN=
# Rate limits
GATEWAY_RATE_LIMIT_PER_MIN=100
# Límite del scraper (slowapi, OWASP A04). El default de la app es 30/min por IP.
# Subirlo SOLO para el E2E de browser: todo su tráfico entra por nginx con la
# misma IP de origen, así que 22 tests barren el presupuesto y la suite falla con
# 429 en ~/global-setup. No tocar en producción (docs/testing.md §3.3).
# RATE_LIMIT_REQUESTS_PER_MINUTE=1000

# Frontera de confianza del proxy (docs/security.md §3). Los defaults de
# docker-compose.yml ya son coherentes entre sí; tocarlos es para redes locales
# con otra subred. Si los cambiás, `docker compose up -d --force-recreate`.
# INTERNAL_SUBNET=10.99.0.0/24
# TRUSTED_PROXY_IP=10.99.0.10
# OTel / Grafana Cloud
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
SERVICE_NAME=