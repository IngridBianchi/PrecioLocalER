{
  "name": "@preciolocal/gateway",
  "version": "1.0.0",
  "description": "API Gateway GraphQL - Apollo Server 4",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
